# Data volume (mounted in Docker). The large/regenerable assets below live only in
# the volume — soundfont is auto-refetched by first-run setup, catalog.json is rebuilt.
/data/kar_raw
/data/videos
/data/audio_lyrics
/data/bgv
# Any SoundFont, not just the one first-run setup downloads: a differently-named copy
# (data/sf.sf2) once slipped past a by-exact-name rule and put 31.7 MB into the history.
/data/*.sf2
/data/manifest.json
# The catalogs are compilations of your own (possibly third-party/ripped) library —
# do NOT publish them. They rebuild locally from data/kar_raw/, data/videos/, data/audio_lyrics/.
/data/catalog.json
/data/catalog-video.json
/data/catalog-audio.json
# Runtime-accumulated shared blocklist of un-embeddable YouTube videoIds (deployment-specific).
/data/youtube-blocklist.json
/_memory
/.vscode
# Local-only tools/content that must never be published (e.g. the bulk downloader).
/private
# Local dev/agent guide (CLAUDE.md) + any local Claude Code config — personal, kept
# out of the repo. The whole .claude/ folder stays untracked.
/.claude
# Redesign/design-system notes + mockups — kept local only, not published in the repo.
/docs
__pycache__/
*.bak

# macOS Finder metadata — noise in every directory it touches.
.DS_Store
