# Keep the build context (and image) lean: the app code is all that's baked in.
# Data comes from the mounted /data volume at runtime, never from the image.
data/
_memory/
.git/
.gitignore
.github/
.vscode/
__pycache__/
*.pyc
*.bak
# macOS filesystem junk (AppleDouble sidecars + Finder metadata). These are
# binary blobs that get scooped into `find src -name '*.js'` and crash esbuild.
**/._*
**/.DS_Store
# Docs aren't needed at runtime.
*.md
